<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Prikazy z Nea (uspat, vypnout, ukoncit aplikaci) smi posilat jen aplikace
         podepsane stejnym klicem (Neo). Stejne opravneni definuje i Neo. -->
    <permission
        android:name="com.neolauncher.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.neolauncher.permission.CONTROL" />
    <!-- Pozna, jestli je aplikace v popredi VR hra (jako Neo). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Upozorneni na slabou baterii / nabito i ve hre (Android 13+ se musi zeptat). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.neolauncher.v1" />
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        tools:ignore="MissingApplicationIcon">

        <!-- Meta tlacitko otevre Neo. Zapina se v Android nastaveni -> Pristupnost. -->
        <service
            android:name=".MetaService"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/meta_service" />
        </service>

        <!-- Pruhledna aktivita: zepta se na povoleni oznameni (otevira ji Neo). -->
        <activity
            android:name=".PermissionActivity"
            android:exported="true"
            android:permission="com.neolauncher.permission.CONTROL"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Prikazy z Nea. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="com.neolauncher.permission.CONTROL" />
    </application>
</manifest>
